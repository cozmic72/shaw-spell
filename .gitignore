# Build directory (all build artifacts)
build/

# Virtual keyboard assets — generated from the external/virtual-keyboard
# submodule (source of truth) into each docroot by the `virtual-keyboard` target.
# The wrapper is a symlink the same target stages into the editor's docroot root;
# src/site/js/virtual-keyboard-modal.js is the tracked original.
src/site/virtual-keyboard/
src/editor/site/virtual-keyboard/
src/editor/site/virtual-keyboard-modal.js
data/wordnet-comprehensive.json
data/definitions-latin-us.json
data/definitions-latin-gb.json
*.o

# Signing configuration (personal certificates)
.signing-config

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build-cache/

# Wiktionary data (large JSONL dumps)
external/wiktionary/

# Supplement pipeline intermediates (rebuildable; never committed). The combined
# pool superseded the per-source *-{deduped,classified,collapsed,decontaminated,
# filtered} files; none of these are tracked.
#
# EXCEPTION: supplement-combined-filtered.json is the COMMITTED checkpoint — the
# build_supplement orchestrator's single output that every downstream target
# consumes. It is tracked so a fresh checkout is up-to-date and `make` skips the
# expensive combine->classify->prune chain (the negation below un-ignores it; the
# glob still ignores the other combined-* debug dumps).
data/supplement-combined-*.json
!data/supplement-combined-filtered.json
data/supplement-wordnet-deduped.json
data/supplement-wiktionary-deduped.json
data/supplement-wordnet-classified.json
data/supplement-wiktionary-classified.json
data/supplement-wordnet-collapsed.json
data/supplement-wiktionary-collapsed.json
data/supplement-wordnet-decontaminated.json
data/supplement-wiktionary-decontaminated.json
data/supplement-wordnet-filtered.json
data/supplement-wiktionary-filtered.json

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Site deployment configuration (per-machine font origin)
.site-config
