[Unit]
Description=Shaw-Spell editorial editor daemon
Documentation=https://joro.io/
After=network.target

[Service]
Type=simple
# The daemon runs unprivileged. Adjust User/Group to match the web server
# account; the socket is created with mode 0666 so any UID can connect.
User=www-data
Group=www-data

# /run/shaw-spell is auto-created for the socket.
RuntimeDirectory=shaw-spell
RuntimeDirectoryMode=0755

# Mutable state lives under /var/lib (NOT /opt code): the daemon writes both
# patch stores there. The auth DB lives under /var/lib too, but only the CGI
# (via Apache SetEnv SHAW_SPELL_AUTH_DB) touches it — not this daemon.
Environment=SHAW_SPELL_PATCH_STORE=/var/lib/shaw-spell/patches/patches.jsonl
Environment=SHAW_SPELL_DEFINITION_PATCH_STORE=/var/lib/shaw-spell/patches/definition-patches.jsonl

ExecStart=/usr/bin/python3 /opt/shaw-spell/editor/editord.py \
    --socket /run/shaw-spell/editord.sock

Restart=on-failure
RestartSec=2s

# Building the annotated view (basis + patch overlay) takes a few seconds; give
# it slack before systemd declares the service failed to start.
TimeoutStartSec=60s

# Unlike suggestd, editord WRITES the patch stores, so it needs one writable
# path: /var/lib/shaw-spell (the /opt code tree and the docroot stay read-only).
# The auth DB lives under the same tree; the CGI (same www-data account) writes it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shaw-spell

[Install]
WantedBy=multi-user.target
