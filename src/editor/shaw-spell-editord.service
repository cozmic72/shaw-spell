[Unit]
Description=Shaw-Spell editorial editor daemon
Documentation=https://joro.io/
After=network.target

[Service]
Type=simple
# The daemon runs unprivileged. Adjust User/Group to match the web server
# account; the socket is created with mode 0666 so any UID can connect.
User=www-data
Group=www-data

# /run/shaw-spell is auto-created for the socket. It is SHARED with the suggest
# daemon (shaw-spell-suggestd), which puts its own socket here. Preserve the dir
# when THIS unit stops, or systemd's default (RuntimeDirectoryPreserve=no) would
# delete /run/shaw-spell and destroy suggestd's live socket too (→ Errno 2).
RuntimeDirectory=shaw-spell
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# The patch stores live INSIDE the `data/` git clone (their repo default:
# PROJECT_ROOT/data/patches/), NOT redirected to /var/lib — that is what makes the
# Commit button's commit+push work: the daemon commits the store in the clone it
# tracks, then pushes. Redirecting the store outside git would sever it from any
# repo and disable committing. So NO SHAW_SPELL_PATCH_STORE override here; the code
# defaults to PROJECT_ROOT/data/patches/{patches,definition-patches}.jsonl. The auth
# DB is the only mutable state still under /var/lib (gitignored, CGI-owned) — pointed
# to by Apache SetEnv SHAW_SPELL_AUTH_DB, not touched by this daemon.

# /opt/shaw-spell holds the COPIED code (src/, external/) plus a standalone git
# CLONE of the data repo at data/. basis.py's PROJECT_ROOT (parent.parent.parent of
# src/tools/basis.py) resolves to /opt/shaw-spell, so the daemon reads the basis and
# writes+commits patches in-place from the data/ clone.
WorkingDirectory=/opt/shaw-spell
ExecStart=/usr/bin/python3 /opt/shaw-spell/src/editor/editord.py \
    --socket /run/shaw-spell/editord.sock

Restart=on-failure
RestartSec=2s

# Building the annotated view (basis + patch overlay) takes a few seconds; give
# it slack before systemd declares the service failed to start.
TimeoutStartSec=60s

# editord WRITES + COMMITS the patch store in the data clone, so its writable path
# is the clone's tree at /opt/shaw-spell/data — which contains BOTH the working tree
# and the clone's own git dir (data/.git), so a single ReadWritePath covers `git
# add`/`commit`/`push`. The docroot and the rest of the /opt code tree stay
# read-only. (The auth DB under /var/lib is written by the CGI, a separate process —
# not this daemon — so it is not listed here.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shaw-spell/data

[Install]
WantedBy=multi-user.target
