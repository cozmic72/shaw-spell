[Unit]
Description=Shaw-Spell editorial editor daemon
Documentation=https://joro.io/
After=network.target

[Service]
Type=simple
# The daemon runs unprivileged. Adjust User/Group to match the web server
# account; the socket is created with mode 0666 so any UID can connect.
User=www-data
Group=www-data

# /run/shaw-spell is auto-created for the socket. It is SHARED with the suggest
# daemon (shaw-spell-suggestd), which puts its own socket here. Preserve the dir
# when THIS unit stops, or systemd's default (RuntimeDirectoryPreserve=no) would
# delete /run/shaw-spell and destroy suggestd's live socket too (→ Errno 2).
RuntimeDirectory=shaw-spell
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# The MUTABLE data clone lives at /var/lib/shaw-spell/data (FHS: mutable state
# under /var, and it must not collide with the dictionary site's install-site,
# which writes /opt/shaw-spell/data). SHAW_SPELL_DATA_DIR points basis.py's
# DATA_ROOT there, relocating the whole clone wholesale: the patch stores, the
# supplement basis, and the published readlex.json.
Environment=SHAW_SPELL_DATA_DIR=/var/lib/shaw-spell/data

# The patch stores live INSIDE that data clone (their repo default:
# DATA_ROOT/patches/) — that is what makes the Commit button's commit+push work:
# the daemon commits the store in the clone it tracks, then pushes. Redirecting
# the store outside git would sever it from any repo and disable committing. So
# NO SHAW_SPELL_PATCH_STORE override here; the code defaults to
# DATA_ROOT/patches/{patches,definition-patches}.jsonl. The auth DB is the other
# mutable state under /var/lib (gitignored, CGI-owned) — pointed to by Apache
# SetEnv SHAW_SPELL_AUTH_DB, not touched by this daemon.

# /opt/shaw-spell holds the COPIED code (src/) and the read-only basis
# (external/). basis.py's PROJECT_ROOT (parent.parent.parent of
# src/tools/basis.py) resolves to /opt/shaw-spell, so every external/ path
# resolves there; everything mutable resolves via SHAW_SPELL_DATA_DIR.
WorkingDirectory=/opt/shaw-spell
ExecStart=/usr/bin/python3 /opt/shaw-spell/src/editor/editord.py \
    --socket /run/shaw-spell/editord.sock

Restart=on-failure
RestartSec=2s

# Building the annotated view (basis + patch overlay) takes a few seconds; give
# it slack before systemd declares the service failed to start.
TimeoutStartSec=60s

# editord WRITES + COMMITS the patch store in the data clone, so its writable path
# is the clone's tree at /var/lib/shaw-spell/data — which contains BOTH the working
# tree and the clone's own git dir (data/.git), so a single ReadWritePath covers
# `git add`/`commit`/`push`. The docroot and the whole /opt tree (code + read-only
# external/ basis) stay read-only. (The auth DB under /var/lib is written by the
# CGI, a separate process — not this daemon — so it is not listed here.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shaw-spell/data

[Install]
WantedBy=multi-user.target
