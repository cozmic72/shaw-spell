#!/usr/bin/env bash
#
# Server-side installer for the Shaw-Spell dictionary site + suggest daemon.
#
# Run from an extracted site tarball as root:  sudo ./install.sh
# It copies the frontend into the web docroot and the daemon + data + hunspell
# dictionaries into place, then enables the shaw-spell-suggestd systemd unit.
# It is idempotent — safe to re-run to upgrade.
#
# This server ALSO hosts the editor (a separate tarball/installer). The two
# share /opt/shaw-spell and the /var/www/shaw-spell docroot, so this script is
# careful to touch ONLY the site's own files (see the scoped-removal notes
# below) and never nukes the whole docroot or /opt tree.
#
# Layout:
#   WWW_ROOT          web tier  (index.cgi, css/, js/, fonts/, templates/, virtual-keyboard/)
#   OPT_ROOT          daemon    (site-daemon/) + data (site-data/, hunspell/)
#
# Override any path by exporting the env var before running, e.g.
#   sudo WWW_ROOT=/srv/www/shaw-spell ./install.sh

set -euo pipefail

WWW_ROOT="${WWW_ROOT:-/var/www/shaw-spell}"
OPT_ROOT="${OPT_ROOT:-/opt/shaw-spell}"
SERVICE_USER="${SERVICE_USER:-www-data}"

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}
[ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] && usage

die() { echo "install.sh: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"

# The extracted tarball root — resolve relative to this script so it works from
# any CWD.
HERE="$(cd "$(dirname "$0")" && pwd)"

# Confirm the tree we expect to copy is actually here before touching anything.
for d in "css" "js" "fonts" "templates" "virtual-keyboard" \
         "site-daemon" "site-data" "hunspell"; do
    [ -d "$HERE/$d" ] || die "expected dir missing from tarball: $d (run from the extracted site/ root)"
done
for f in "index.cgi" \
         ".htaccess" \
         "site-daemon/suggestd.py" \
         "site-daemon/shaw-spell-suggestd.service"; do
    [ -f "$HERE/$f" ] || die "expected file missing from tarball: $f"
done

echo "==> Installing Shaw-Spell site"
echo "    web:      $WWW_ROOT"
echo "    daemon:   $OPT_ROOT/{site-daemon,site-data,hunspell}"
echo

# --- web tier (frontend, served by the CGI) ---
# The docroot is SHARED with the editor, which lives in $WWW_ROOT/editor. We
# must NOT rm -rf the whole docroot (that would wipe the editor). Install the
# top-level file individually, and for the asset dirs we own, rm -rf ONLY those
# specific subdirs before re-copying — never a sibling like editor/.
echo "==> Web tier -> $WWW_ROOT"
mkdir -p "$WWW_ROOT"
install -m 755 "$HERE/index.cgi" "$WWW_ROOT/index.cgi"
# .htaccess enables CGI/DirectoryIndex for the docroot. Its DirectoryIndex only
# applies where no more-specific rule exists, so it doesn't disturb editor/.
[ -f "$HERE/.htaccess" ] && install -m 644 "$HERE/.htaccess" "$WWW_ROOT/.htaccess"
[ -f "$HERE/.version" ] && install -m 644 "$HERE/.version" "$WWW_ROOT/.version"
for d in css js fonts templates virtual-keyboard; do
    rm -rf "${WWW_ROOT:?}/$d"
    cp -R "$HERE/$d" "$WWW_ROOT/$d"
done

# --- daemon + data + dictionaries ---
# /opt/shaw-spell is SHARED with the editor, which owns $OPT_ROOT/{src,external,
# data}. We own ONLY site-daemon/, site-data/, hunspell/. Scope every removal to
# those three subdirs; NEVER rm -rf "$OPT_ROOT" (that would destroy the editor's
# code and ~317MB basis).
echo "==> Daemon + data -> $OPT_ROOT"
mkdir -p "$OPT_ROOT"
for d in site-daemon site-data hunspell; do
    rm -rf "${OPT_ROOT:?}/$d"
    cp -R "$HERE/$d" "$OPT_ROOT/$d"
done

# --- systemd unit ---
install -m 644 "$HERE/site-daemon/shaw-spell-suggestd.service" \
              /etc/systemd/system/shaw-spell-suggestd.service

# --- hunspell python binding check (prerequisite for the daemon) ---
# The daemon does `import hunspell` (pyhunspell) at startup and fails fast if
# it's absent. Warn loudly with the exact fix rather than enabling a unit that
# will crash-loop silently.
HUNSPELL_OK=1
if ! python3 -c "import hunspell" 2>/dev/null; then
    HUNSPELL_OK=0
    echo
    echo "!! WARNING: python3 cannot 'import hunspell' — the daemon WILL fail to start." >&2
    echo "!! Install the prerequisite, then re-run this script (or just restart the unit):" >&2
    echo "!!     sudo apt install libhunspell-dev" >&2
    echo "!!     sudo pip3 install hunspell" >&2
    echo
fi

# --- systemd ---
echo "==> systemd daemon-reload + enable"
systemctl daemon-reload
if [ "$HUNSPELL_OK" -eq 1 ]; then
    systemctl enable --now shaw-spell-suggestd
else
    # Enable so it starts on next boot / after the prereq is installed, but do
    # NOT --now: starting it now would just crash-loop on the missing import.
    systemctl enable shaw-spell-suggestd
    echo "   (enabled but NOT started — install hunspell then: sudo systemctl start shaw-spell-suggestd)"
fi

# --- summary + remaining manual steps ---
cat <<SUMMARY

============================================================
Installed:
  web tier   -> $WWW_ROOT (index.cgi, css/, js/, fonts/, templates/, virtual-keyboard/)
  daemon     -> $OPT_ROOT/site-daemon + /etc/systemd/system/shaw-spell-suggestd.service
  data       -> $OPT_ROOT/{site-data,hunspell}
  (the editor's $WWW_ROOT/editor and $OPT_ROOT/{src,external,data} are untouched)

The CGI talks to the daemon over /run/shaw-spell/suggestd.sock. If the daemon
is down, the site returns errors (no silent fallback).

Remaining MANUAL steps (this script cannot safely do these):

1. Apache must serve $WWW_ROOT with CGI enabled (ExecCGI, .cgi handler,
   DirectoryIndex index.cgi). The owner's Apache already does this, so this is
   typically a NO-OP — verify with:  curl -sI https://<host>/ | head -1
SUMMARY

if [ "$HUNSPELL_OK" -eq 0 ]; then
    cat <<'SUMMARY'
2. Install the hunspell python binding (see the WARNING above), then:
     sudo systemctl start shaw-spell-suggestd
SUMMARY
fi

echo "============================================================"
echo "Done."
