[Unit]
Description=Shaw-Spell dictionary + spell-suggestion daemon
Documentation=https://joro.io/
After=network.target

[Service]
Type=simple
# The daemon runs unprivileged. Adjust User/Group to match the web server
# account; the socket is created with mode 0666 so any UID can connect.
User=www-data
Group=www-data

# /run/shaw-spell is auto-created for the socket. It is SHARED with the editor
# daemon (shaw-spell-editord), which puts its own socket here. Preserve the dir
# when THIS unit stops, or systemd's default (RuntimeDirectoryPreserve=no) would
# delete /run/shaw-spell and destroy the editor's live socket too (→ Errno 2).
RuntimeDirectory=shaw-spell
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

ExecStart=/usr/bin/python3 /opt/shaw-spell/site-daemon/suggestd.py \
    --socket /run/shaw-spell/suggestd.sock \
    --hunspell-dir /opt/shaw-spell/hunspell \
    --data-dir /opt/shaw-spell/site-data

Restart=on-failure
RestartSec=2s

# Loading 6 entry caches takes a few seconds; give it some slack before
# systemd declares the service failed to start.
TimeoutStartSec=60s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/shaw-spell

[Install]
WantedBy=multi-user.target
